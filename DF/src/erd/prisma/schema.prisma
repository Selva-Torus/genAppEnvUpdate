datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
provider = "prisma-client-js"
}
model tob_api_repository {
  id  String @id @default(auto()) @map("_id") @db.ObjectId 
  apiname    String?        
  version    String?        
  release_date    DateTime?      
  api_category    String?        
  server_url    String?        
  status    String?        
  api_resourcepath    String?        

  tob_api_process_logs   tob_api_process_logs[]    
  trs_created_date    DateTime     @default(now())  
  trs_created_by    String?       
  trs_modified_date    DateTime     @updatedAt  
  trs_modified_by    String?              
  trs_process_id    String?
  trs_access_profile    String?
  trs_org_grp_code    String?
  trs_org_code    String?
  trs_role_grp_code    String?
  trs_role_code    String?
  trs_ps_grp_code    String?
  trs_ps_code     String?
  trs_sub_org_grp_code    String?
  trs_sub_org_code    String?
  trs_locked_by    String?
  trs_locked_time    DateTime?
  trs_tenant_id    String @default("00000")
  trs_app_code     String @default("00000")
  trs_product_code String @default("00000_00000")
  trs_event_process_status String?
  trs_event_status         String? 

  @@map("ct003_tob.tob_api_repository")
  
}
model tob_consent_request {
  id  String @id @default(auto()) @map("_id") @db.ObjectId 
  ids    String?        
  consentgroupid    String?        
  requesturl    String?        
  consenttype    String?        
  status    String?        
  request    tob_consent_req? 
  consentbody    tob_consentbody? 
  authorizationchannel  authorizationchannel_tob_consent_request?    
  interactionid    String?        
  tpp    tob_tpp? 
  updatedat    Int?       
  parid    String?        
  rartype    String?        
  standardversion    String?        
  psuidentifiers    tob_psuidentifiers? 
  accountids    String[]      
  connecttoken    String?        
  account_id    String?        

  tob_api_process_logs   tob_api_process_logs[]    
  trs_created_date    DateTime     @default(now())  
  trs_created_by    String?       
  trs_modified_date    DateTime     @updatedAt  
  trs_modified_by    String?              
  trs_process_id    String?
  trs_access_profile    String?
  trs_org_grp_code    String?
  trs_org_code    String?
  trs_role_grp_code    String?
  trs_role_code    String?
  trs_ps_grp_code    String?
  trs_ps_code     String?
  trs_sub_org_grp_code    String?
  trs_sub_org_code    String?
  trs_locked_by    String?
  trs_locked_time    DateTime?
  trs_tenant_id    String @default("00000")
  trs_app_code     String @default("00000")
  trs_product_code String @default("00000_00000")
  trs_event_process_status String?
  trs_event_status         String? 

  @@map("ct003_tob.tob_consent_request")
  
}
model tob_api_process_logs {
  id  String @id @default(auto()) @map("_id") @db.ObjectId 
  apiendpoint    String?        
  requestdata    Json?      
  responsedata    Json?      
  apiname    String?        

  tob_api_repositoryid String? @db.ObjectId
  tob_api_repository   tob_api_repository?   @relation(fields: [tob_api_repositoryid], references: [id])   
  tob_consent_requestid String? @db.ObjectId
  tob_consent_request   tob_consent_request?   @relation(fields: [tob_consent_requestid], references: [id])   
  trs_created_date    DateTime     @default(now())  
  trs_created_by    String?       
  trs_modified_date    DateTime     @updatedAt  
  trs_modified_by    String?              
  trs_process_id    String?
  trs_access_profile    String?
  trs_org_grp_code    String?
  trs_org_code    String?
  trs_role_grp_code    String?
  trs_role_code    String?
  trs_ps_grp_code    String?
  trs_ps_code     String?
  trs_sub_org_grp_code    String?
  trs_sub_org_code    String?
  trs_locked_by    String?
  trs_locked_time    DateTime?
  trs_tenant_id    String @default("00000")
  trs_app_code     String @default("00000")
  trs_product_code String @default("00000_00000")
  trs_event_process_status String?
  trs_event_status         String? 

  @@map("ct003_tob.tob_api_process_logs")
  
}
